# WebSocket RPC for reading events (Alchemy/QuickNode wss://)
WS_RPC_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Private RPC for MEV protection (Flashbots Protect)
PRIVATE_RPC_URL=https://rpc.flashbots.net

# Wallet private key (DO NOT SHARE!)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Address of the ArbitrageExecutor contract from base-arbitrage-project
CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS

# Minimum profit for execution (in ETH)
MIN_PROFIT=0.001

# Pool addresses (find the current ones on Base)
UNISWAP_POOL=0x...
AERODROME_POOL=0x...

# Arbitrage tokens
TOKEN_A=0x4200000000000000000000000000000000000006
TOKEN_B=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Pool fees (3000 = 0.3%, 500 = 0.05%)
FEE_1=3000
FEE_2=3000

